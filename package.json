{
  "name": "opencode-bot",
  "version": "0.1.0",
  "description": "Persistent local-first AI teammates, scheduled tasks and approvals powered by OpenCode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:plugin && bun run build:daemon && bun run build:types",
    "build:plugin": "bun build ./index.ts --outdir ./dist --target bun",
    "build:daemon": "bun build ./src/server.ts --outdir ./dist --target bun && bun run scripts/copy-assets.ts",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun run src/server.ts",
    "start": "bun run dist/server.js",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.2",
    "@types/node": "^25.0.10",
    "electron": "^28.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.1.25"
  },
  "dependencies": {
    "croner": "^9.0.0",
    "dotenv": "^17.2.3"
  },
  "keywords": [
    "opencode",
    "plugin",
    "mailbox",
    "cron",
    "agents",
    "automation",
    "dashboard",
    "messaging"
  ],
  "author": "Culture Digitali (fork based on richardanaya/opencode-cron)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CultureDigitali/opencode-bot.git"
  },
  "homepage": "https://github.com/CultureDigitali/opencode-bot#readme",
  "bugs": {
    "url": "https://github.com/CultureDigitali/opencode-bot/issues"
  }
}
