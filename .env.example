# By default only this machine can reach the dashboard.
OPENCODE_BOT_HOST=127.0.0.1
OPENCODE_BOT_PORT=4271
# Mandatory when listening on a LAN IP / 0.0.0.0.
# Generate a random long token and never commit the value.
OPENCODE_BOT_TOKEN=
# Optional: defaults to ~/.config/opencode/cron.db, sharing the legacy cron plugin database.
# OPENCODE_BOT_DB=C:/path/to/opencode-bot.db
# Optional: limit agent working directory to a dedicated project.
# OPENCODE_BOT_WORKSPACE=C:/path/to/workspace
OPENCODE_BOT_TASK_TIMEOUT_MS=900000
